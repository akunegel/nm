---
Language: Cpp
BasedOnStyle: LLVM

# 42 Norm: 4-character real tabs and 80 columns width limit
IndentWidth: 4
TabWidth: 4
UseTab: Always
ColumnLimit: 180

# 42 Norm: Braces on a separate line (Allman style)
BreakBeforeBraces: Allman

# 42 Norm: Pointers stuck to variable names
PointerAlignment: Right

# 42 Norm: Control statements followed by space
SpaceBeforeParens: ControlStatements

# Miscellaneous
SpaceBeforeAssignmentOperators: true
SortIncludes: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
...
